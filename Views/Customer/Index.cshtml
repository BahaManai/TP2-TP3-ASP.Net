@model IEnumerable<Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="page-header">
    <h1>Clients</h1>
    <a asp-action="Create" class="btn btn-primary">Ajouter un client</a>
</div>

<div class="table-card">
<table class="table table-hover table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Membership type</th>
            <th>Discount</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var customer in Model)
    {
        <tr>
            <td>@customer.Name</td>
            <td>@customer.Email</td>
            <td>@customer.MembershipType?.Name</td>
            <td>@customer.MembershipType?.DiscountPercent %</td>
        </tr>
    }
    </tbody>
</table>
</div>

<details class="mt-4">
    <summary>SQL généré avec Include</summary>
    <pre>@ViewBag.IncludeSql</pre>
</details>
<details class="mt-3">
    <summary>SQL généré avec Select</summary>
    <pre>@ViewBag.ProjectionSql</pre>
</details>
