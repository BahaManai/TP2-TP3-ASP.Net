@model Movie
@{
    ViewData["Title"] = "Supprimer un film";
}

<div class="page-header">
    <h1>Supprimer un film</h1>
</div>

<div class="card content-card danger-card">
    <p>Voulez-vous vraiment supprimer <strong>@Model.Name</strong> ?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Supprimer</button>
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
    </form>
</div>
