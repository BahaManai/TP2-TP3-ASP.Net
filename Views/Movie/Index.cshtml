@model IEnumerable<Movie>
@{
    ViewData["Title"] = "Films";
    var currentPage = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var pageSize = (int)ViewBag.PageSize;
    var sortOrder = (string?)ViewBag.SortOrder;
}

<div class="page-header">
    <h1>Films</h1>
    <a asp-action="Create" class="btn btn-primary">Ajouter un film</a>
</div>

<div class="table-card">
    <table class="table table-hover table-striped">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSortParam" asp-route-pageSize="@pageSize">Nom</a>
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewBag.GenreSortParam" asp-route-pageSize="@pageSize">Genre</a>
                </th>
                <th>Disponibilité</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var movie in Model)
        {
            <tr>
                <td>@movie.Name</td>
                <td>@movie.Genre?.Name</td>
                <td>
                    @if (movie.IsAvailable)
                    {
                        <span class="badge text-bg-success">Disponible</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Loué</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@movie.Id" class="btn btn-sm btn-outline-primary">Détails</a>
                    <a asp-action="Edit" asp-route-id="@movie.Id" class="btn btn-sm btn-outline-secondary">Modifier</a>
                    <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<nav class="mt-3" aria-label="Pages des films">
    <a class="btn btn-outline-secondary @(currentPage <= 1 ? "disabled" : "")"
       asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" asp-route-sortOrder="@sortOrder">Précédent</a>
    <span class="mx-2">Page @currentPage sur @Math.Max(totalPages, 1)</span>
    <a class="btn btn-outline-secondary @(currentPage >= totalPages ? "disabled" : "")"
       asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" asp-route-sortOrder="@sortOrder">Suivant</a>
</nav>
