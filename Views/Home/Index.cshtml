@{
    ViewData["Title"] = "Accueil";
}

<section class="text-center py-4">
    <h1 class="display-5 fw-semibold mb-3">Application de gestion de cinéma</h1>
    <p class="lead text-secondary mb-4">
        Gérez les films, les genres, les clients et les avis depuis une interface unique.
    </p>
</section>

<div class="row g-4">
    <div class="col-md-6 col-lg-3">
        <div class="card home-card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Films</h2>
                <p class="card-text text-secondary flex-grow-1">Consulter le catalogue et gérer les films.</p>
                <a asp-controller="Movie" asp-action="Index" class="btn btn-primary">Voir les films</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card home-card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Genres</h2>
                <p class="card-text text-secondary flex-grow-1">Consulter et ajouter les genres.</p>
                <a asp-controller="Genre" asp-action="Index" class="btn btn-outline-primary">Voir les genres</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card home-card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Clients</h2>
                <p class="card-text text-secondary flex-grow-1">Consulter les clients et leurs abonnements.</p>
                <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-primary">Voir les clients</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card home-card h-100">
            <div class="card-body d-flex flex-column">
                <h2 class="h5 card-title">Avis</h2>
                <p class="card-text text-secondary flex-grow-1">Consulter les avis associés à chaque film.</p>
                <a asp-controller="Movie" asp-action="Index" class="btn btn-outline-primary">Choisir un film</a>
            </div>
        </div>
    </div>
</div>
